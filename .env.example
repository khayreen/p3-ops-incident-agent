# Copy to .env and fill in. Never commit .env.

# Which LLM to use: groq | gemini | openrouter | ollama
LLM_PROVIDER=groq

# Only the key for your chosen provider is needed. Ollama needs none.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional: override the provider's default model. It must support tool calling.
# Free-tier model names change; if a call fails with "model not found", pick a
# current one from the provider's model list.
# LLM_MODEL=openai/gpt-oss-120b
